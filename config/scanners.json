[
  {"category":"Price & Volume","name":"Green Daily Candle","description":"Close is above open on the latest candle.","conditions":[{"field":"close","operator":">","compare_mode":"field","compare_field":"open"}]},
  {"category":"Price & Volume","name":"Volume Surge","description":"Volume is at least twice its 20-day average.","conditions":[{"field":"volume_ratio20","operator":">=","compare_mode":"value","compare_value":2}]},
  {"category":"Trend","name":"Bullish Trend Alignment","description":"Price and moving averages are aligned upward.","conditions":[{"field":"close","operator":">","compare_mode":"field","compare_field":"sma20"},{"field":"sma20","operator":">","compare_mode":"field","compare_field":"sma50"},{"field":"sma50","operator":">","compare_mode":"field","compare_field":"sma200"}]},
  {"category":"Trend","name":"Bearish Trend Alignment","description":"Price and moving averages are aligned downward.","conditions":[{"field":"close","operator":"<","compare_mode":"field","compare_field":"sma20"},{"field":"sma20","operator":"<","compare_mode":"field","compare_field":"sma50"},{"field":"sma50","operator":"<","compare_mode":"field","compare_field":"sma200"}]},
  {"category":"Momentum","name":"Bullish Momentum","description":"Price rises at least 2% with above-average volume.","conditions":[{"field":"change_pct","operator":">=","compare_mode":"value","compare_value":2},{"field":"volume_ratio20","operator":">=","compare_mode":"value","compare_value":1.5}]},
  {"category":"Momentum","name":"RSI Oversold","description":"14-day RSI is below 30.","conditions":[{"field":"rsi14","operator":"<","compare_mode":"value","compare_value":30}]},
  {"category":"Momentum","name":"RSI Overbought","description":"14-day RSI is above 70.","conditions":[{"field":"rsi14","operator":">","compare_mode":"value","compare_value":70}]},
  {"category":"Breakouts","name":"20-Day High Breakout","description":"Close exceeds the prior 20-session high.","conditions":[{"field":"close","operator":">","compare_mode":"field","compare_field":"previous_high20"}]},
  {"category":"Breakouts","name":"20-Day Low Breakdown","description":"Close falls below the prior 20-session low.","conditions":[{"field":"close","operator":"<","compare_mode":"field","compare_field":"previous_low20"}]},
  {"category":"52-Week Range","name":"Near 52-Week High","description":"Close is within 5% of its 52-week high.","conditions":[{"field":"distance_52w_high_pct","operator":"<=","compare_mode":"value","compare_value":5}]},
  {"category":"52-Week Range","name":"Near 52-Week Low","description":"Close is within 5% of its 52-week low.","conditions":[{"field":"distance_52w_low_pct","operator":"<=","compare_mode":"value","compare_value":5}]},
  {"category":"Candlestick Patterns","name":"Doji","description":"Body is no more than 10% of the candle range.","conditions":[{"field":"doji","operator":"=","compare_mode":"value","compare_value":1}]},
  {"category":"Candlestick Patterns","name":"Bullish Engulfing","description":"Latest bullish body engulfs the previous bearish body.","conditions":[{"field":"bullish_engulfing","operator":"=","compare_mode":"value","compare_value":1}]},
  {"category":"Candlestick Patterns","name":"Bearish Engulfing","description":"Latest bearish body engulfs the previous bullish body.","conditions":[{"field":"bearish_engulfing","operator":"=","compare_mode":"value","compare_value":1}]},
